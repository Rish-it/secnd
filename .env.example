# All paths are relative to the repository root when running locally.
SECND_DATA_DIR=.data
SECND_FRONTEND_DIST=frontend/dist
SECND_FEATURIZER=pt-minilm
SECND_ENCODER_REPO=Secnd-AI/ren
SECND_ENCODER_REVISION=5560f25414195f1d1224a6ae7efd19c6b7646d3f

# Reader checkpoints and the pinned MiniLM retrieval model must already be installed locally.
# Missing files/device fail startup; no automatic fallback. Revisions default to the audited
# checkpoint fingerprints in backend/reader-manifest.json. No quantization.
SECND_SERVING_BACKEND=head
SECND_READER='{"model_id":"ic-ettin-150m-s6000-near","device":"cpu","examples":8}'
# GPU alternative: {"model_id":"ic-ettin-400m-s6000-near","device":"cuda","examples":8}
# Explicit per-workspace selection; use "head" for the existing encoder + classifier.
SECND_WORKSPACE_BACKENDS='{}'
SECND_WORKSPACE_READERS='{}'

# Meta app webhooks. Sending stays off until both token and flag are configured.
SECND_META_APP_SECRET=
SECND_META_VERIFY_TOKEN=
SECND_WHATSAPP_TOKEN=
SECND_WHATSAPP_SEND_ENABLED=false
SECND_META_GRAPH_VERSION=v25.0

# Optional provider access; never expose this key to the frontend.
SECND_MUSE_API_KEY=
SECND_MUSE_BASE_URL=https://inference.baseten.co/v1
SECND_MUSE_MODEL=meta-models/muse-spark-open-1026
SECND_MUSE_BUDGET_USD=10

# Primary provider; separate budget and ledger. Read .env with Settings, never source it.
SECND_META_API_KEY=
SECND_META_BASE_URL=https://api.meta.ai/v1
SECND_META_MODEL=muse-spark-1.3
SECND_META_BUDGET_USD=10

# Third provider; separate $25 total cap.
NEBIUS_API_KEY=
SECND_NEBIUS_BUDGET_USD=10
